{
  "compilerOptions": {
    "typeRoots": ["api/@types", "node_modules/@types"],
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "rewriteRelativeImportExtensions": true,
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"],
}
